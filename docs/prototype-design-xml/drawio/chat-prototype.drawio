<mxfile host="app.diagrams.net" agent="xml-diagram">
  <diagram name="Chat Prototype" id="chat-prototype">
    <mxGraphModel dx="420" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="375" pageHeight="667" math="0" shadow="0" background="#F6F8FB">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 页面标题 -->
        <mxCell id="page-title" value="消息聊天原型" style="text=;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=20;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="125" y="20" width="125" height="30" as="geometry" />
        </mxCell>

        <!-- 联系人信息栏 -->
        <mxCell id="header-bar" value="" style="rounded=0;arcSize=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D8E1EA;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="295" height="60" as="geometry" />
        </mxCell>

        <!-- 联系人头像 -->
        <mxCell id="avatar" value="" style="ellipse;html=1;whiteSpace=wrap;fillColor=#2563EB;strokeColor=none;" vertex="1" parent="header-bar">
          <mxGeometry x="16" y="10" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- 联系人名称 -->
        <mxCell id="contact-name" value="张三" style="text=;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=16;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="header-bar">
          <mxGeometry x="66" y="12" width="100" height="20" as="geometry" />
        </mxCell>

        <!-- 在线状态 -->
        <mxCell id="status" value="在线" style="text=;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=12;fontColor=#15803D;" vertex="1" parent="header-bar">
          <mxGeometry x="66" y="34" width="60" height="16" as="geometry" />
        </mxCell>

        <!-- 消息列表区域 -->
        <mxCell id="message-list" value="" style="rounded=0;arcSize=0;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="125" width="295" height="450" as="geometry" />
        </mxCell>

        <!-- 接收方消息气泡 -->
        <mxCell id="msg-received" value="你好，最近怎么样？" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fillColor=#EEF3F8;strokeColor=#D8E1EA;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=14;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="message-list">
          <mxGeometry x="16" y="20" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- 接收方时间戳 -->
        <mxCell id="time-received" value="14:28" style="text=;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=11;fontColor=#64748B;" vertex="1" parent="message-list">
          <mxGeometry x="16" y="65" width="50" height="16" as="geometry" />
        </mxCell>

        <!-- 发送方消息气泡 -->
        <mxCell id="msg-sent" value="挺好的，谢谢关心！" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fillColor=#2563EB;strokeColor=none;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=14;fontColor=#FFFFFF;align=right;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="message-list">
          <mxGeometry x="99" y="100" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- 发送方时间戳 -->
        <mxCell id="time-sent" value="14:30" style="text=;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=11;fontColor=#64748B;" vertex="1" parent="message-list">
          <mxGeometry x="230" y="145" width="50" height="16" as="geometry" />
        </mxCell>

        <!-- 更多消息示例 -->
        <mxCell id="msg-received-2" value="最近在忙什么项目？" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fillColor=#EEF3F8;strokeColor=#D8E1EA;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=14;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="message-list">
          <mxGeometry x="16" y="180" width="200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="time-received-2" value="14:32" style="text=;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=11;fontColor=#64748B;" vertex="1" parent="message-list">
          <mxGeometry x="16" y="225" width="50" height="16" as="geometry" />
        </mxCell>

        <mxCell id="msg-sent-2" value="在做一个AI助手项目" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fillColor=#2563EB;strokeColor=none;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=14;fontColor=#FFFFFF;align=right;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="message-list">
          <mxGeometry x="119" y="260" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="time-sent-2" value="14:35" style="text=;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=11;fontColor=#64748B;" vertex="1" parent="message-list">
          <mxGeometry x="230" y="305" width="50" height="16" as="geometry" />
        </mxCell>

        <!-- 输入区域 -->
        <mxCell id="input-area" value="" style="rounded=0;arcSize=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D8E1EA;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="575" width="295" height="60" as="geometry" />
        </mxCell>

        <!-- 附件按钮 -->
        <mxCell id="attach-btn" value="+" style="ellipse;html=1;whiteSpace=wrap;fillColor=#EEF3F8;strokeColor=#D8E1EA;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=20;fontStyle=1;fontColor=#475569;" vertex="1" parent="input-area">
          <mxGeometry x="12" y="12" width="36" height="36" as="geometry" />
        </mxCell>

        <!-- 输入框 -->
        <mxCell id="input-box" value="输入消息..." style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#D8E1EA;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=14;fontColor=#64748B;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="input-area">
          <mxGeometry x="56" y="10" width="180" height="40" as="geometry" />
        </mxCell>

        <!-- 发送按钮 -->
        <mxCell id="send-btn" value="发送" style="rounded=1;arcSize=15;html=1;whiteSpace=wrap;fillColor=#2563EB;strokeColor=none;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=14;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="input-area">
          <mxGeometry x="246" y="10" width="40" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
