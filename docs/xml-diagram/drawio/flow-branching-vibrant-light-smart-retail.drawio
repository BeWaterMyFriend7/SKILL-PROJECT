<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram name="订单履约分支流程" id="flow-branching-example" theme="vibrant" mode="light">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0" background="#F6F8FB">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="diagram-title" value="订单履约分支流程" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=24;fontColor=#172033;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="480" height="42" as="geometry" />
        </mxCell>
        <mxCell id="flow-start" value="开始" style="rounded=1;arcSize=10;fillColor=#1B9CDE;strokeColor=#1B9CDE;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=14;fontColor=#000000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="100" height="56" as="geometry" />
        </mxCell>
        <mxCell id="step-1" value="接收订单" style="rounded=1;arcSize=10;fillColor=#F4E7F7;strokeColor=#D7ACE2;html=1;whiteSpace=wrap;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=14;fontColor=#832F98;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="190" width="260" height="72" as="geometry" />
        </mxCell>
        <mxCell id="decision-1" value="库存充足？" style="rhombus;fillColor=#F2E6D9;strokeColor=#F2C69A;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=14;fontColor=#172033;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="310" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="step-2" value="锁定库存并发货" style="rounded=1;arcSize=10;fillColor=#DBE9DF;strokeColor=#ACDBBA;html=1;whiteSpace=wrap;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=14;fontColor=#2F8B4B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="500" width="260" height="72" as="geometry" />
        </mxCell>
        <mxCell id="error-1" value="通知缺货并退款" style="rounded=1;arcSize=10;fillColor=#FEF2F2;strokeColor=#DC2626;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=13;fontColor=#B91C1C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="330" width="240" height="72" as="geometry" />
        </mxCell>
        <mxCell id="flow-end" value="结束" style="rounded=1;arcSize=10;fillColor=#1B9CDE;strokeColor=#1B9CDE;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=14;fontColor=#000000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="610" width="100" height="56" as="geometry" />
        </mxCell>
        <mxCell id="flow-edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B9CDE;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="flow-start" target="step-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B9CDE;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="step-1" target="decision-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-edge-3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B9CDE;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="decision-1" target="step-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-edge-4" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="decision-1" target="error-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow-edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B9CDE;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="step-2" target="flow-end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>