{
  "skill_name": "svg-generator",
  "design_system_version": "1.0",
  "evals": [
    {
      "id": "architecture-application",
      "prompt": "生成电商平台应用架构图，包含终端、核心系统和外部依赖。",
      "template": "templates/architecture/application-architecture.svg",
      "output_file": "output/svg/application-architecture.svg",
      "validator": "python scripts/validate_svg.py output/svg/application-architecture.svg --fail-on-warning",
      "assertions": ["存在且仅有一个主标题", "核心系统为视觉焦点", "正文不小于 12px", "元素不重叠且边距至少 30px", "画布利用率介于 60% 和 80%"]
    },
    {
      "id": "architecture-business",
      "prompt": "生成零售业务架构图，区分业务场景、业务能力和业务对象。",
      "template": "templates/architecture/business-architecture.svg",
      "output_file": "output/svg/business-architecture.svg",
      "validator": "python scripts/validate_svg.py output/svg/business-architecture.svg --fail-on-warning",
      "assertions": ["三层结构从上到下排列", "各层标题清晰", "卡片文字无占位重复", "颜色来自本 skill 视觉标记", "无裁切和遮挡"]
    },
    {
      "id": "architecture-technical",
      "prompt": "生成分层技术架构图，包含接入、服务、中间件、数据、基础设施与横切能力。",
      "template": "templates/architecture/technical-architecture.svg",
      "output_file": "output/svg/technical-architecture.svg",
      "validator": "python scripts/validate_svg.py output/svg/technical-architecture.svg --fail-on-warning",
      "assertions": ["技术层级顺序正确", "横切能力独立成区", "容器与卡片层级明确", "普通正文不小于 12px", "无元素越界"]
    },
    {
      "id": "architecture-deployment",
      "prompt": "生成跨可用区部署架构图，体现网络边界、计算子网和数据子网。",
      "template": "templates/architecture/deployment-architecture.svg",
      "output_file": "output/svg/deployment-architecture.svg",
      "validator": "python scripts/validate_svg.py output/svg/deployment-architecture.svg --fail-on-warning",
      "assertions": ["区域边界嵌套正确", "计算与数据域分离", "虚线只表示边界或异步语义", "节点间距一致", "无裁切和拥挤"]
    },
    {
      "id": "architecture-context",
      "prompt": "生成支付平台系统上下文图，展示用户、核心系统和外部系统。",
      "template": "templates/architecture/system-context.svg",
      "output_file": "output/svg/system-context.svg",
      "validator": "python scripts/validate_svg.py output/svg/system-context.svg --fail-on-warning",
      "assertions": ["核心系统居中突出", "外部参与者分区清楚", "关系标签可读", "连线不穿过节点", "语义色使用一致"]
    },
    {
      "id": "architecture-application-dark-content",
      "prompt": "使用统一浅色设计语言生成智能客服应用架构图，不使用大面积高饱和色块。",
      "template": "templates/architecture/application-architecture.svg",
      "output_file": "output/svg/customer-service-application.svg",
      "validator": "python scripts/validate_svg.py output/svg/customer-service-application.svg --fail-on-warning",
      "assertions": ["保持浅色专业主题", "主色不超过三种", "核心系统占据主要视觉面积", "文字对比清晰", "标题和说明完整"]
    },
    {
      "id": "architecture-business-density",
      "prompt": "生成包含四个业务域的供应链业务架构图，控制信息密度。",
      "template": "templates/architecture/business-architecture.svg",
      "output_file": "output/svg/supply-chain-business.svg",
      "validator": "python scripts/validate_svg.py output/svg/supply-chain-business.svg --fail-on-warning",
      "assertions": ["每卡片最多两行说明", "同层卡片等宽等距", "普通正文不小于 12px", "层间留白一致", "无重复占位内容"]
    },
    {
      "id": "architecture-deployment-resilience",
      "prompt": "生成高可用票务系统部署架构图，突出弹性、数据与审计能力。",
      "template": "templates/architecture/deployment-architecture.svg",
      "output_file": "output/svg/ticket-deployment.svg",
      "validator": "python scripts/validate_svg.py output/svg/ticket-deployment.svg --fail-on-warning",
      "assertions": ["高可用边界表达明确", "计算与数据节点不混排", "存储使用青色语义", "边界留白至少 30px", "浏览器可直接渲染"]
    }
  ]
}
