        <mxCell id="state-1" value="待支付" style="rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#CAD3DF;html=1;whiteSpace=wrap;fontFamily=Inter, Noto Sans SC, Microsoft YaHei, sans-serif;fontSize=14;fontColor=#243B63;fontStyle=1;" vertex="1" parent="1">
