<mxfile host="app.diagrams.net">
  <diagram name="ER图-用户订单系统">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" pageWidth="1000" pageHeight="570" pageBackground="#f8f9fa">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="用户订单系统ER图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="330" y="40" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="entity-user" value="用户 (User)&#10;────────────&#10;+ id: int (PK)&#10;+ username: varchar(50)&#10;+ email: varchar(100)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#333333;fontSize=12;align=left;spacingLeft=12;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="130" y="130" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="entity-order" value="订单 (Order)&#10;────────────&#10;+ order_id: int (PK)&#10;+ order_date: datetime&#10;+ total_amount: decimal(10,2)&#10;+ user_id: int (FK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#333333;fontSize=12;align=left;spacingLeft=12;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="430" y="130" width="220" height="125" as="geometry" />
        </mxCell>
        <mxCell id="entity-item" value="订单项 (OrderItem)&#10;────────────&#10;+ item_id: int (PK)&#10;+ quantity: int&#10;+ unit_price: decimal(10,2)&#10;+ order_id: int (FK)&#10;+ product_id: int (FK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#333333;fontSize=12;align=left;spacingLeft=12;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="730" y="130" width="210" height="140" as="geometry" />
        </mxCell>
        <mxCell id="entity-product" value="产品 (Product)&#10;────────────&#10;+ product_id: int (PK)&#10;+ name: varchar(100)&#10;+ price: decimal(10,2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#333333;fontSize=12;align=left;spacingLeft=12;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="580" y="350" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rel-places" value="下单" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e67e22;strokeWidth=1;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="365" y="220" width="50" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rel-contains" value="包含" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e67e22;strokeWidth=1;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="665" y="220" width="50" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rel-refers" value="关联" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e67e22;strokeWidth=1;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="300" width="50" height="40" as="geometry" />
        </mxCell>
        <mxCell id="edge-u-rel" edge="1" parent="1" source="entity-user" target="rel-places">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-u-rel-label" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontColor=#666666;" vertex="1" connectable="0" parent="edge-u-rel">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint x="15" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-rel-o" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999999;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="rel-places" target="entity-order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-rel-o-label" value="N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontColor=#666666;" vertex="1" connectable="0" parent="edge-rel-o">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint x="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-o-rel2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999999;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="entity-order" target="rel-contains">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-o-rel2-label" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontColor=#666666;" vertex="1" connectable="0" parent="edge-o-rel2">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint x="15" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-rel2-i" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999999;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="rel-contains" target="entity-item">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-rel2-i-label" value="N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontColor=#666666;" vertex="1" connectable="0" parent="edge-rel2-i">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint x="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-i-rel3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999999;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="entity-item" target="rel-refers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-i-rel3-label" value="N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontColor=#666666;" vertex="1" connectable="0" parent="edge-i-rel3">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint x="15" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-rel3-p" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#999999;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="rel-refers" target="entity-product">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-rel3-p-label" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontColor=#666666;" vertex="1" connectable="0" parent="edge-rel3-p">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint x="-15" as="offset" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
