{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xml-diagram-plan-v1",
  "title": "Draw.io DiagramPlan",
  "type": "object",
  "required": ["designSystemVersion", "renderer", "type", "theme", "title", "canvas", "sections", "nodes", "edges"],
  "properties": {
    "designSystemVersion": { "const": "1.0" },
    "renderer": { "const": "drawio" },
    "type": {
      "enum": [
        "business_architecture", "application_architecture", "technical_architecture",
        "deployment_architecture", "system_context", "simple_step_flow", "structured_flow",
        "sequence_diagram", "state_diagram", "er_diagram", "comparison", "decision_matrix",
        "swot", "roadmap_timeline", "lifecycle_flow", "summary", "knowledge_map"
      ]
    },
    "theme": { "enum": ["light", "dark"] },
    "density": { "enum": ["compact", "standard", "spacious"], "default": "standard" },
    "template": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "margin"],
      "properties": {
        "width": { "type": "integer", "minimum": 600, "maximum": 1800 },
        "height": { "type": "integer", "minimum": 360, "maximum": 1400 },
        "margin": { "type": "integer", "minimum": 30 }
      }
    },
    "sections": { "type": "array", "items": { "type": "object", "required": ["id", "title"], "properties": { "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 } } } },
    "nodes": { "type": "array", "items": { "type": "object", "required": ["id", "label"], "properties": { "id": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 } } } },
    "edges": { "type": "array", "items": { "type": "object", "required": ["id", "source", "target"], "properties": { "id": { "type": "string", "minLength": 1 }, "source": { "type": "string", "minLength": 1 }, "target": { "type": "string", "minLength": 1 } } } },
    "legends": { "type": "array", "default": [] },
    "participants": { "type": "array", "default": [] },
    "messages": { "type": "array", "default": [] },
    "assumptions": { "type": "array", "default": [] },
    "enrichment": { "type": "object" }
  },
  "additionalProperties": false
}
