<mxfile host="app.diagrams.net">
  <diagram name="Flow">
    <mxGraphModel grid="0" page="1" pageScale="1" pageWidth="1000" pageHeight="320" background="#F6F8FB" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="流程图标题" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=26;fontStyle=1;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="260" y="24" width="480" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="start" value="开始" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#172033;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="110" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="step" value="处理步骤" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8E1EA;strokeWidth=2;fontColor=#172033;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="210" y="144" width="190" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="decision" value="条件满足？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#D97706;fontColor=#172033;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="134" width="150" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="end" value="结束" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#16A34A;fontColor=#172033;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="160" width="110" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="start" target="step">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="继续" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="step" target="decision">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="decision" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
